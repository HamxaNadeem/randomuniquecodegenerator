<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hamxanadeem.blockygems.ui.BackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/vibrationButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/vibration"
                android:src="@drawable/ic_vibration" />

            <ImageButton
                android:id="@+id/soundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/sound"
                android:src="@drawable/ic_volume_on" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <com.hamxanadeem.blockygems.ui.LogoView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/bestText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="36dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playButton"
                style="@style/GameButton"
                android:layout_width="240dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_button_play"
                android:textSize="28sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/newGameButton"
                style="@style/GameButton"
                android:layout_width="200dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/new_game"
                android:visibility="gone" />

            <Button
                android:id="@+id/privacyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/privacy_settings"
                android:textColor="@color/text_soft"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp" />
    </LinearLayout>
</FrameLayout>
